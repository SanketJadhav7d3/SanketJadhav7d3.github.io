---
title: projects
layout: base.njk
permalink: /projects/
---

<section class="projects-intro montserrat-400">
  <h1 class="pixel-art-secondary-header">{{ title }}</h1>
</section>

<section class="projects-grid body-text-font">
  {% for project in collections.projects %}
    <article class="project-card">
      <a href="{{ project.url }}" class="project-card-link">
        {% if project.data.cover %}
        <div class="project-card-cover">
          {% if project.data.cover.endsWith(".mp4") %}
          <video src="{{ project.data.cover }}" autoplay muted loop playsinline></video>
          {% else %}
          <img src="{{ project.data.cover }}" alt="{{ project.data.title }}" loading="lazy">
          {% endif %}
        </div>
        {% endif %}
        <div class="project-card-content">
          <h2 class="project-title">{{ project.data.title }}</h2>
          <p class="project-excerpt">
            {{ project.data.summary or project.templateContent | striptags | truncate(160) }}
          </p>
        </div>
      </a>
    </article>
  {% endfor %}
</section>