---
title: blogs
pageTitle: Blog — Sanket Jadhav
layout: base.njk
permalink: /blogs/
---

<header class="page-head">
  <h1>Blog</h1>
  <p class="lede">Notes on things I’m learning.</p>
</header>

<ul class="post-list">
  {% for blog in collections.blogs %}
  <li>
    <a href="{{ blog.url }}">
      <span class="post-title">{{ blog.data.title }}</span>
      <span class="post-desc">{{ blog.data.description }}</span>
    </a>
    <time datetime="{{ blog.date.toISOString() }}">{{ blog.date | monthYear }}</time>
  </li>
  {% endfor %}
</ul>
