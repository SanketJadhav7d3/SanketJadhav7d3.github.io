---
layout: base.njk
---

<article class="project">
  <a href="/blogs/" class="back-link">← All posts</a>

  <header class="project-head">
    <h1>{{ title }}</h1>
    {% if date %}
    <div class="project-meta"><time datetime="{{ date.toISOString() }}">{{ date | monthYear }}</time></div>
    {% endif %}
  </header>

  {% if cover %}
  <figure class="project-cover"><img src="{{ cover }}" alt=""></figure>
  {% endif %}

  <div class="prose">{{ content | safe }}</div>
</article>
