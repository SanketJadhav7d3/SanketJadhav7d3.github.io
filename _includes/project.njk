---
layout: base.njk
---

<article class="project">
  <a href="/projects/" class="back-link">← All projects</a>

  <header class="project-head">
    <h1>{{ title }}</h1>
    {% if summary %}<p class="lede">{{ summary }}</p>{% endif %}

    <div class="project-meta">
      {% if date %}<time datetime="{{ date.toISOString() }}">{{ date | monthYear }}</time>{% endif %}
      {% if role %}<span>{{ role }}</span>{% endif %}
    </div>

    {% if tech %}
    <ul class="chips">{% for t in tech %}<li>{{ t }}</li>{% endfor %}</ul>
    {% endif %}

    {% if link or repo %}
    <div class="hero-actions">
      {% if link %}<a class="button" href="{{ link }}" target="_blank" rel="noopener">Visit site</a>{% endif %}
      {% if repo %}<a class="button button-secondary" href="{{ repo }}" target="_blank" rel="noopener">View source</a>{% endif %}
    </div>
    {% endif %}
  </header>

  {% if cover %}
    {#- One `cover` field takes an image or a video; the extension decides which
        element to render. An optional `coverPoster` gives a video a still frame
        to show before it starts. -#}
    {% set coverIsVideo = cover.endsWith(".mp4") or cover.endsWith(".webm") or cover.endsWith(".mov") %}
    <figure class="project-cover">
    {% if coverIsVideo %}
      <video src="{{ cover }}"
             {% if coverPoster %}poster="{{ coverPoster }}"{% endif %}
             autoplay loop muted playsinline controls
             aria-label="Cover video for {{ title }}"></video>
    {% else %}
      <img src="{{ cover }}" alt="Cover image for {{ title }}">
    {% endif %}
    </figure>
  {% endif %}

  <div class="prose">{{ content | safe }}</div>
</article>
