---
layout: base.njk
title: home
pageTitle: Sanket Jadhav — AI & machine learning
permalink: /
isHomePage: true
---

{% set skills = [
  { group: "Languages", items: ["Python", "JavaScript"] },
  { group: "AI & ML", items: ["PyTorch", "TensorFlow", "scikit-learn", "NumPy", "pandas", "LangGraph", "RAG"] },
  { group: "Web", items: ["HTML", "CSS", "React", "Node.js"] },
  { group: "Tools", items: ["Git", "Docker", "Google Cloud Run"] }
] %}

<section class="hero">
  <img src="/assets/images/tachikoma.jpg" alt="Sanket Jadhav" class="avatar" width="96" height="96">
  <div>
    <h1>Hi, I’m Sanket.</h1>
    <p class="lede">
      I’m a computer science master’s student interested in AI and how intelligent systems
      shape the world around us. I learn by building: agents, retrieval systems and computer
      vision models. For fun, I make small games.
    </p>
    <div class="hero-actions">
      <a class="button" href="/projects/">See my projects</a>
      <a class="button button-secondary" href="https://linkedin.com/in/sanket-jadhav-b01398237" target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a>
    </div>
  </div>
</section>

<section class="section" id="projects">
  <div class="section-head">
    <h2>Projects</h2>
    <a href="/projects/" class="section-link">View all →</a>
  </div>
  <div class="card-grid">
    {% for project in collections.projects | head(6) %}
      {% include "project-card.njk" %}
    {% endfor %}
  </div>
</section>

<section class="section" id="experience">
  <h2>Experience</h2>
  <ul class="entries">
    {% for item in experience %}
    <li class="entry">
      {% if item.logo %}<span class="entry-logo"><img src="/{{ item.logo }}" alt="{{ item.company }}"></span>{% endif %}
      <div>
        <h3>{{ item.role }}, {{ item.company }}</h3>
        <p class="entry-date">{{ item.date }}</p>
        <p>{{ item.description }}</p>
      </div>
    </li>
    {% endfor %}
  </ul>
</section>

<section class="section" id="education">
  <h2>Education</h2>
  <ul class="entries">
    {% for item in education %}
    <li class="entry">
      {% if item.logo %}<span class="entry-logo"><img src="/{{ item.logo }}" alt="{{ item.institution }}"></span>{% endif %}
      <div>
        <h3>{{ item.degree }}</h3>
        <p class="entry-org">{{ item.institution }}</p>
        <p class="entry-date">{{ item.date }}</p>
        <p>{{ item.description }}</p>
      </div>
    </li>
    {% endfor %}
  </ul>
</section>

<section class="section" id="skills">
  <h2>Skills</h2>
  <dl class="skills">
    {% for s in skills %}
    <div class="skill-row">
      <dt>{{ s.group }}</dt>
      <dd>
        <ul class="chips">{% for i in s.items %}<li>{{ i }}</li>{% endfor %}</ul>
      </dd>
    </div>
    {% endfor %}
  </dl>
</section>

<section class="section" id="blog">
  <div class="section-head">
    <h2>Writing</h2>
    <a href="/blogs/" class="section-link">All posts →</a>
  </div>
  <ul class="post-list">
    {% for post in collections.blogs | head(4) %}
    <li>
      <a href="{{ post.url }}">
        <span class="post-title">{{ post.data.title }}</span>
        <span class="post-desc">{{ post.data.description or post.data.summary }}</span>
      </a>
      <time datetime="{{ post.date.toISOString() }}">{{ post.date | monthYear }}</time>
    </li>
    {% endfor %}
  </ul>
</section>
